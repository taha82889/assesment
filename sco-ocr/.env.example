# Copy to .env (never commit). The RTSP URL carries access to transaction data.
RTSP_URL=rtsp://HOST:PORT/live
REDIS_URL=redis://localhost:6379/0
# comma-separated: stdout,redis,websocket
SINK=stdout
FPS=3
LOG_LEVEL=INFO
# Crop retention: off | lowconf | all   (off by default, GDPR data minimisation)
CROP_RETENTION=off
CAPTURE_DIR=captures
